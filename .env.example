# Copy to .env and fill in. Never commit .env.

# Secret for signing JWTs (required in production). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Public Overpass instance. Comma-separated fallbacks are tried when the main one answers 429.
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_FALLBACK_URLS=
# e.g. OVERPASS_FALLBACK_URLS=https://maps.mail.ru/osm/tools/overpass/api/interpreter
# Check /api/status for a free slot before each query (true/false).
OVERPASS_CHECK_STATUS=true

# Identify yourself to the Overpass operators.
USER_AGENT=OverpassTagHunter/0.1 (github.com/your-name/overpass-tag-hunter)

# API server port (the Vite dev server proxies /api to it). PORT is used if API_PORT is unset.
API_PORT=3000
# Largest scan, in zoom-14 tiles.
MAX_TILES=150
# SQLite file location (defaults to <repo>/data/tag-hunter.db).
# DB_PATH=
